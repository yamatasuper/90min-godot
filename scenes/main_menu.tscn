[node name="Body" type="Label" parent="AboutOverlay/Card/Text"]
layout_mode = 2
text = "Девяносто минут последнего матча — вся жизнь. История читается как манга: страница, кадр, облачко.

Ты не симулируешь футбол. Ты проживаешь конец карьеры и смотришь, кем останешься.

Прибрежье. Стадион «Торпедо». Соперник — «Прибой».
Герой — Алексей Бардин, 34. Опорник. Бывший капитан."
autowrap_mode = 3

[node name="Hint" type="Label" parent="AboutOverlay/Card/Text"]
